<section class="page-hero surface-night edge-mist-bottom"><canvas class="starfield" data-starfield data-density="0.0003"></canvas><div class="page-width"><h1>Order {{ order.name }}</h1></div></section>
<section class="section section--tight surface-mist"><div class="page-width">
<div class="rte">
  <p><a href="{{ routes.account_url }}">← Back to account</a></p>
  <p>Placed on {{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
  <table><thead><tr><th>Item</th><th>Qty</th><th>Total</th></tr></thead><tbody>
    {%- for line_item in order.line_items -%}
      <tr><td>{{ line_item.title }}{% if line_item.fulfillment %}<br><small>{{ line_item.fulfillment.tracking_company }} {% if line_item.fulfillment.tracking_url %}<a href="{{ line_item.fulfillment.tracking_url }}">Track</a>{% endif %}</small>{% endif %}</td><td>{{ line_item.quantity }}</td><td>{{ line_item.final_line_price | money }}</td></tr>
    {%- endfor -%}
  </tbody></table>
  <p>Subtotal: {{ order.line_items_subtotal_price | money }}<br>Shipping: {{ order.shipping_price | money }}<br>Tax: {{ order.tax_price | money }}<br><strong>Total: {{ order.total_price | money_with_currency }}</strong></p>
  {%- if order.shipping_address -%}<h3>Shipping address</h3>{{ order.shipping_address | format_address }}{%- endif -%}
</div>
</div></section>
