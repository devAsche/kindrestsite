<section class="page-hero surface-night edge-mist-bottom"><canvas class="starfield" data-starfield data-density="0.0003"></canvas><div class="page-width"><h1>Addresses</h1></div></section>
<section class="section section--tight surface-mist"><div class="page-width">
<div class="rte">
  <p><a href="{{ routes.account_url }}">← Back to account</a></p>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="form-card" style="margin:0 0 20px;max-width:none">
        {{ address | format_address }}
        {%- if address == customer.default_address -%}<p class="form-note">Default</p>{%- endif -%}
        <details><summary class="form-note">Edit</summary>
          {%- form 'customer_address', address -%}
            <div class="field"><label>First name</label><input type="text" name="address[first_name]" value="{{ form.first_name }}"></div>
            <div class="field"><label>Last name</label><input type="text" name="address[last_name]" value="{{ form.last_name }}"></div>
            <div class="field"><label>Address</label><input type="text" name="address[address1]" value="{{ form.address1 }}"></div>
            <div class="field"><label>Apartment, suite</label><input type="text" name="address[address2]" value="{{ form.address2 }}"></div>
            <div class="field"><label>City</label><input type="text" name="address[city]" value="{{ form.city }}"></div>
            <div class="field"><label>Country</label><select name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select></div>
            <div class="field"><label>State</label><input type="text" name="address[province]" value="{{ form.province }}"></div>
            <div class="field"><label>ZIP</label><input type="text" name="address[zip]" value="{{ form.zip }}"></div>
            <div class="field"><label>Phone</label><input type="tel" name="address[phone]" value="{{ form.phone }}"></div>
            <label class="form-note"><input type="checkbox" name="address[default]" value="1"> Set as default</label>
            <p><button type="submit" class="btn">Save</button></p>
          {%- endform -%}
        </details>
      </div>
    {%- endfor -%}
  {%- endpaginate -%}
  <h2>Add a new address</h2>
  <div class="form-card" style="margin:0;max-width:none">
    {%- form 'customer_address', customer.new_address -%}
      <div class="field"><label>First name</label><input type="text" name="address[first_name]"></div>
      <div class="field"><label>Last name</label><input type="text" name="address[last_name]"></div>
      <div class="field"><label>Address</label><input type="text" name="address[address1]"></div>
      <div class="field"><label>Apartment, suite</label><input type="text" name="address[address2]"></div>
      <div class="field"><label>City</label><input type="text" name="address[city]"></div>
      <div class="field"><label>Country</label><select name="address[country]" data-default="United States">{{ all_country_option_tags }}</select></div>
      <div class="field"><label>State</label><input type="text" name="address[province]"></div>
      <div class="field"><label>ZIP</label><input type="text" name="address[zip]"></div>
      <div class="field"><label>Phone</label><input type="tel" name="address[phone]"></div>
      <p><button type="submit" class="btn">Add address</button></p>
    {%- endform -%}
  </div>
</div>
</div></section>
