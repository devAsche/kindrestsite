<section class="page-hero surface-night edge-mist-bottom"><canvas class="starfield" data-starfield data-density="0.0003"></canvas><div class="page-width"><h1>Reset password</h1></div></section>
<section class="section section--tight surface-mist"><div class="page-width">
<div class="form-card">
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ResetPw">New password</label><input id="ResetPw" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetPw2">Confirm password</label><input id="ResetPw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--block">Reset password</button>
  {%- endform -%}
</div>
</div></section>
