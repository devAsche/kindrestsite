{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Gift card · {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="surface-night" style="min-height:100vh;display:grid;place-items:center;text-align:center;padding:24px">
    <div>
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="section-title">Your gift card</h1>
      <p style="font-size:32px;font-weight:700">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p>This gift card is no longer active.</p>{%- endif -%}
      <p style="font-family:monospace;font-size:20px;letter-spacing:.1em;background:#fff;color:#0e1630;display:inline-block;padding:10px 18px;border-radius:12px">{{ gift_card.code | format_code }}</p>
      {%- if gift_card.expires_on -%}<p>Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>{%- endif -%}
      <p style="margin-top:24px"><a class="btn btn--moon" href="{{ shop.url }}">Shop now</a></p>
    </div>
  </body>
</html>
