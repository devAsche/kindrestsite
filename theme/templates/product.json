    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "item",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Keep it in the freezer. When you want a quiet break, pull it over your head and down over your eyes, then rest.</p>"
          }
        },
        "q2": {
          "type": "item",
          "settings": {
            "question": "Will it fit me?",
            "answer": "<p>It's a one-size stretch fit designed to cover the head and eyes of most adults.</p>"
          }
        },
        "q3": {
          "type": "item",
          "settings": {
            "question": "What's in the 2-Pack?",
            "answer": "<p>Two caps in the color you choose — one to wear while the other chills, or one for each of you.</p>"
          }
        },
        "q4": {
          "type": "item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Shipping to US addresses is free. Orders ship within 1–3 business days and usually arrive 5–11 business days after shipping. You'll get a tracking number by email.</p>"
          }
        },
        "q5": {
          "type": "item",
          "settings": {
            "question": "What if something's wrong with my order?",
            "answer": "<p>If it arrives damaged, defective, or isn't what you ordered, email a photo to contact@kindreststore.com within 30 days of delivery. We'll send a replacement or a full refund, and you don't need to send anything back. We can't accept returns for a change of mind, so please read the details before you order.</p>"
          }
        },
        "q6": {
          "type": "item",
          "settings": {
            "question": "Who is it for?",
            "answer": "<p>Anyone who wants a cool, dark, quiet break at the end of a long screen day: after work, before bed, or on a warm night. It's a comfort item made for resting, not a medical device. If you have a health concern, please talk to your doctor.</p>"
          }
        }
      },
