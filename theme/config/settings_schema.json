[
  {
    "name": "theme_info",
    "theme_name": "Kindrest Quiet Hours",
    "theme_version": "1.0.0",
    "theme_author": "Kindrest",
    "theme_documentation_url": "https://kindreststore.com",
    "theme_support_url": "https://kindreststore.com/pages/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Playful touches",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_intro",
        "label": "Screen-to-night intro on the home page",
        "default": true,
        "info": "Shown once per visit. Skips automatically for visitors who prefer reduced motion."
      },
      {
        "type": "text",
        "id": "intro_line_1",
        "label": "Intro line (bright screen)",
        "default": "Your screen has been bright all day."
      },
      {
        "type": "text",
        "id": "intro_line_2",
        "label": "Intro line (night)",
        "default": "Let's dim the lights."
      },
      {
        "type": "checkbox",
        "id": "enable_star_trail",
        "label": "Star trail behind the cursor (desktop)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quiet_toggle",
        "label": "Quiet Hours dim toggle in the header",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_upsell",
        "label": "Show an add-on in the cart drawer",
        "default": true
      },
      {
        "type": "product",
        "id": "upsell_product",
        "label": "Add-on product"
      },
      {
        "type": "image_picker",
        "id": "upsell_image",
        "label": "Add-on image",
        "info": "Optional. Square image; replaces the product photo in the cart."
      },
      {
        "type": "text",
        "id": "upsell_label",
        "label": "Add-on label",
        "default": "Pairs well with"
      },
      {
        "type": "text",
        "id": "upsell_text",
        "label": "Add-on text",
        "default": "A soft wrap for your neck and shoulders."
      },
      {
        "type": "text",
        "id": "cart_note_text",
        "label": "Note above checkout",
        "default": "Shipping and taxes are calculated at checkout."
      },
      {
        "type": "url",
        "id": "empty_cart_url",
        "label": "Empty cart button link"
      }
    ]
  },
  {
    "name": "Set offer",
    "settings": [
      {
        "type": "paragraph",
        "content": "Promotes the automatic discount 'Cap + Neck Wrap'. The percentage here must match the discount set in Shopify (Discounts). Cart lines always show the discount Shopify actually applied."
      },
      {
        "type": "checkbox",
        "id": "enable_set_offer",
        "label": "Show the set offer",
        "default": false
      },
      {
        "type": "number",
        "id": "set_offer_percent",
        "label": "Discount on the add-on (%)",
        "default": 20
      },
      {
        "type": "text",
        "id": "set_offer_qualifying_value",
        "label": "Qualifying option value",
        "default": "1 Cap",
        "info": "The cap option that unlocks the offer (must match the variant option exactly)."
      },
      {
        "type": "product",
        "id": "set_offer_cap",
        "label": "Qualifying product (cap)"
      },
      {
        "type": "product",
        "id": "set_offer_addon",
        "label": "Discounted add-on (neck wrap)"
      },
      {
        "type": "text",
        "id": "set_offer_note",
        "label": "Fine print on the cap page",
        "default": "Applies to the 1 Cap option, not the 2-Pack. One discounted wrap per cap. Applied automatically at checkout."
      }
    ]
  }
]