<section class="section promise surface-night edge-mist-top" style="--edge-from: {{ section.settings.edge_from }};">
  <canvas class="starfield" data-starfield data-density="0.0002"></canvas>
  <div class="page-width">
    <div class="promise__moon reveal" aria-hidden="true"></div>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="promise__text">{{ section.settings.text }}</p>
    <div class="promise__ctas">
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--moon" href="{{ section.settings.cta_link | default: '#buy' }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promise + final CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Kindrest promise" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Rest easy about your order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "If your order arrives damaged, defective, or isn't what you ordered, email us a photo within 30 days of delivery and we'll send a replacement or a full refund. No need to send anything back. (We can't take returns for a change of mind.)" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start your Quiet Hours" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to scroll to the buy box." },
    { "type": "color", "id": "edge_from", "label": "Color of the section above", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Promise + final CTA" }]
}
{% endschema %}
