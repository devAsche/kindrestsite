<section class="section section--tight surface-mist">
  <div class="page-width">
    {%- if collection.description != blank -%}<div class="rte center" style="margin-bottom:32px">{{ collection.description }}</div>{%- endif -%}
    {%- paginate collection.products by 24 -%}
      <div class="grid">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- else -%}<p>No products here yet.</p>{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="center" style="margin-top:32px">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}{ "name": "Product grid" }{% endschema %}
