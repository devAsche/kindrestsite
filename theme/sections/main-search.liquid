<section class="section section--tight surface-mist">
  <div class="page-width">
    <form action="{{ routes.search_url }}" method="get" role="search" class="form-card" style="max-width:640px;margin-bottom:40px">
      <div class="field" style="margin:0"><label for="SearchQ" class="visually-hidden">Search</label><input id="SearchQ" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the store"></div>
      <input type="hidden" name="type" value="product">
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- else -%}<a class="pcard" href="{{ item.url }}"><h3 class="pcard__title">{{ item.title }}</h3></a>{%- endif -%}
          {%- else -%}<p>No results for “{{ search.terms }}”.</p>{%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<div class="center" style="margin-top:32px">{{ paginate | default_pagination }}</div>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Search results" }{% endschema %}
