{%- if section.settings.text != blank -%}
  {%- assign items = section.settings.text | split: '|' -%}
  <div class="announcement{% if section.settings.marquee %} announcement--marquee{% endif %}">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
    {%- if section.settings.marquee -%}
      <div class="marquee" aria-label="{{ section.settings.text | replace: '|', ' · ' | escape }}">
        {%- for n in (1..2) -%}
          <div class="marquee__group" {% if n == 2 %}aria-hidden="true"{% endif %}>
            {%- for i in (1..3) -%}
              {%- for item in items -%}<span>{{ item | strip }}</span><span class="announcement__star">✦</span>{%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <span class="announcement__star">✦</span>{{ items.first | strip }}<span class="announcement__star">✦</span>
    {%- endif -%}
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Messages (separate with |)", "default": "The 2-Pack is here | One to wear, one in the freezer | Made for your quiet hours" },
    { "type": "checkbox", "id": "marquee", "label": "Scroll messages", "default": true },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
