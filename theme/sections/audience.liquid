<section class="section surface-moon" id="for-you">
  <div class="page-width">
    <div class="center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p class="section-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="cards">
      {%- for block in section.blocks -%}
        <article class="card reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 120 }}ms">
          <div class="card__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 861px) 33vw, 82vw' }}
            {%- else -%}
              <canvas class="starfield" data-starfield data-density="0.0009" style="position:absolute;inset:0;width:100%;height:100%"></canvas>
              <div class="card__img-fallback">{% render 'icon', name: block.settings.icon %}</div>
            {%- endif -%}
          </div>
          <div class="card__body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Who it's for",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made for the end of the day" },
    { "type": "text", "id": "title", "label": "Heading", "default": "When it's time to power down" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "icon", "label": "Icon (when no image)", "default": "desk", "options": [
          { "value": "desk", "label": "Desk" }, { "value": "moon", "label": "Moon" }, { "value": "two", "label": "Two" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "After a long desk day" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "For the days the screen has been on since morning. Close the laptop, pull it on, and step away for a while." }
      ]
    }
  ],
  "presets": [{ "name": "Who it's for", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
