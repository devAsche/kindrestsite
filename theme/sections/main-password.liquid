<div class="page-width center" style="padding:48px var(--gutter)">
  <p class="logo" style="justify-content:center;color:#fff">{% render 'icon', name: 'star-mark' %}<span>{{ shop.name }}</span></p>
  <h1 class="section-title" style="margin-top:24px">{{ section.settings.title }}</h1>
  {%- if shop.password_message != blank -%}<p class="section-lead">{{ shop.password_message }}</p>{%- endif -%}
  <details style="margin-top:28px">
    <summary style="cursor:pointer;opacity:.75">Enter with password</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field" style="max-width:320px;margin:16px auto"><label for="Pw" class="visually-hidden">Password</label><input id="Pw" type="password" name="password" placeholder="Password" style="color:var(--ink)"></div>
      <button type="submit" class="btn btn--moon">Enter</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{ "name": "Password page", "settings": [ { "type": "text", "id": "title", "label": "Heading", "default": "Opening soon" } ] }
{% endschema %}
