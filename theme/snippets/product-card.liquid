<a class="pcard reveal" href="{{ product.url }}">
  <div class="pcard__img">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', widths: '360, 540, 700', alt: product.title }}
    {%- endif -%}
  </div>
  <h3 class="pcard__title">{{ product.title }}</h3>
  <div class="pcard__price">
    {%- if product.price_varies -%}From {% endif -%}{{ product.price_min | money }}
  </div>
</a>
