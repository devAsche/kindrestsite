<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Nunito+Sans:wght@400;700&display=swap" rel="stylesheet">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="surface-night" style="min-height:100vh;display:grid;place-items:center">
    <canvas class="starfield" data-starfield data-density="0.0003" style="position:fixed;inset:0;width:100%;height:100%;z-index:-1"></canvas>
    {{ content_for_layout }}
  </body>
</html>
