<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0e1630">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'photo.css' | asset_url | stylesheet_tag }}
    <style>:root { --night-texture: url('{{ 'kindrest-night-texture.webp' | file_url }}'); }</style>
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    <script>
      window.Kindrest = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cart: {{ routes.cart_url | append: '.js' | json }},
          cartPage: {{ routes.cart_url | json }}
        },
        intro: {{ settings.enable_intro | json }},
        trail: {{ settings.enable_star_trail | json }}
      };
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {%- if settings.enable_intro and template.name == 'index' -%}
      <div class="intro" id="Intro" aria-hidden="true">
        <div class="intro__screen"></div>
        <div class="intro__night">
          <canvas class="intro__stars" data-starfield data-density="0.00025"></canvas>
        </div>
        <p class="intro__line intro__line--1">{{ settings.intro_line_1 }}</p>
        <p class="intro__line intro__line--2">{{ settings.intro_line_2 }}</p>
        <button type="button" class="intro__skip" data-intro-skip tabindex="-1">Skip</button>
      </div>
    {%- endif -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    <div class="shooting-star" aria-hidden="true"></div>
  </body>
</html>
